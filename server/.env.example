# ==================== SERVER CONFIGURATION ====================
PORT=5000
APP_URL=http://localhost:5000

# ==================== GOOGLE APPS SCRIPT INTEGRATION ====================
# Deploy server/apps-script/Code.gs as a Web app (see server/apps-script/README.md)
# and paste its /exec URL here. No service account or key file needed.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# ==================== EMAIL (GMAIL) CONFIGURATION ====================
# Use Gmail App Password (not your regular password)
# Generate at: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ==================== ADMIN CREDENTIALS ====================
# Default admin login: phone=admin, password=admin123